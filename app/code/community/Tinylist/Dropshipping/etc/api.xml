<?xml version="1.0"?>
<config>
    <api>
        <resources>
            <tinylist_dropshipping_order_invoice translate="title" module="tinylist_dropshipping">
                <title>Tinylist Dropshipping - Order Invoice PDF</title>
                <model>tinylist_dropshipping/order_invoice_api</model>
                <acl>sales/order/invoice</acl>
                <methods>
                    <pdf translate="title" module="tinylist_dropshipping">
                        <title>Retrieve order invoice PDF</title>
                        <method>pdf</method>
                        <acl>sales/order/invoice/info</acl>
                    </pdf>
                </methods>
                <faults module="tinylist_dropshipping">
                    <order_not_exists>
                        <code>101</code>
                        <message>Requested order does not exist.</message>
                    </order_not_exists>
                    <invoice_pdf_failed>
                        <code>102</code>
                        <message>Could not render the invoice PDF.</message>
                    </invoice_pdf_failed>
                </faults>
            </tinylist_dropshipping_order_invoice>

            <tinylist_dropshipping_order_tracking translate="title" module="tinylist_dropshipping">
                <title>Tinylist Dropshipping - Carrier Tracking Status</title>
                <model>tinylist_dropshipping/order_tracking_api</model>
                <acl>sales/order/info</acl>
                <methods>
                    <status translate="title" module="tinylist_dropshipping">
                        <title>Fetch live carrier status for an order tracking number</title>
                        <method>status</method>
                        <acl>sales/order/info</acl>
                    </status>
                </methods>
            </tinylist_dropshipping_order_tracking>
            <!--
                ACL is the stock catalog/product/info, deliberately, rather than
                a resource of our own. The install script is idempotent and
                skips a role that already exists, so a new resource would never
                reach a store that installed an earlier version — every such
                merchant would get "Access denied" until someone edited their
                role by hand. catalog/product/info is already granted by the
                role, and describes exactly what this returns.
            -->
            <tinylist_dropshipping_catalog translate="title" module="tinylist_dropshipping">
                <title>Tinylist Dropshipping - Catalogue Digest</title>
                <model>tinylist_dropshipping/catalog_digest_api</model>
                <acl>catalog/product</acl>
                <methods>
                    <digest translate="title" module="tinylist_dropshipping">
                        <title>Price and stock for a page of products</title>
                        <method>digest</method>
                        <acl>catalog/product/info</acl>
                    </digest>
                </methods>
                <faults module="tinylist_dropshipping">
                    <store_view_not_found>
                        <code>103</code>
                        <message>Requested store view does not exist.</message>
                    </store_view_not_found>
                    <invalid_updated_since>
                        <code>104</code>
                        <message>updatedSince is not a parseable date.</message>
                    </invalid_updated_since>
                </faults>
            </tinylist_dropshipping_catalog>
        </resources>

        <v2>
            <resources_function_prefix>
                <tinylist_dropshipping_order_invoice>tinylistDropshippingOrderInvoice</tinylist_dropshipping_order_invoice>
                <tinylist_dropshipping_order_tracking>tinylistDropshippingOrderTracking</tinylist_dropshipping_order_tracking>
                <tinylist_dropshipping_catalog>tinylistDropshippingCatalog</tinylist_dropshipping_catalog>
            </resources_function_prefix>
        </v2>
    </api>
</config>
